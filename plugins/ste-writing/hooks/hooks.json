{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|ApplyPatch|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/ste-lint-hook.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
